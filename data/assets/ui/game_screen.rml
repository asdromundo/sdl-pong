<rml>

    <head>
        <title>Game</title>
        <style>
            body {
                width: 100%;
                height: 100%;
                font-family: "Pixel Operator 8";
                color: #ffffff;
            }

            #score {
                position: absolute;
                top: 2.5vh;
                left: 0;
                width: 100%;
                text-align: center;
                font-size: 3.2vh;
                letter-spacing: 0.1em;
            }

            /* Keep the HUD legible and out of the way on tall/narrow viewports. */
            @media (max-aspect-ratio: 3 / 4) {
                #score {
                    top: 1.5vh;
                    font-size: 2.6vh;
                }
            }
        </style>
    </head>

    <body>
        <div id="score">00 | 00</div>
    </body>
</rml>
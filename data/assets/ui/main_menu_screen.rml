<rml>

    <head>
        <title>Main Menu</title>
        <style>
            /*
                Menu UI. The logo is drawn by the SDL layer over the top half
                of the screen (see MainMenuScene::Render), so the RmlUi content
                is anchored to the bottom. All sizes are viewport-relative so
                the layout scales across desktop, web and Android.
            */
            body {
                box-sizing: border-box;
                width: 100%;
                height: 100%;
                font-family: "Pixel Operator 8";
                font-size: 2.2vh;
                color: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                align-items: center;
                padding-bottom: 12vh;
            }

            #title {
                font-size: 8em;
                letter-spacing: 0.3em;
                margin: 0 0 1.2em 0;
            }

            button {
                box-sizing: border-box;
                display: block;
                width: 80%;
                max-width: 15em;
                margin: 0.6em 0;
                padding: 0.9em 0;
                font-size: 1em;
                text-align: center;
                background-color: transparent;
                border: 0.12em #ffffff;
                color: #ffffff;
                cursor: pointer;
            }

            /* Focus/hover/active inverts to the classic paddle look. */
            button:hover,
            button:focus,
            button:active {
                background-color: #ffffff;
                color: #0c0c0c;
            }

            #hint {
                position: absolute;
                bottom: 2vh;
                left: 0;
                width: 100%;
                text-align: center;
                font-size: 1.1em;
                opacity: 0.55;
            }

            /*
                Tall/narrow viewports (phones in portrait) get less vertical
                breathing room, since the SDL logo still reserves the top half
                of the screen regardless of aspect ratio.
            */
            @media (max-aspect-ratio: 3 / 4) {
                body {
                    padding-bottom: 8vh;
                }

                #title {
                    font-size: 5em;
                    margin-bottom: 0.8em;
                }

                #ball {
                    margin-bottom: 1em;
                }

                button {
                    width: 90%;
                    padding: 0.7em 0;
                    margin: 0.4em 0;
                }

                #hint {
                    font-size: 1em;
                    padding: 0.7em 0;
                }
            }
        </style>
    </head>

    <body>
        <div id="title">PONG</div>
        <button id="solo">SOLO</button>
        <button id="single">SINGLE PLAYER</button>
        <button id="two">TWO PLAYERS</button>
        <div id="hint">
            <p><strong>W/S OR ARROWS TO MOVE | ESC TO QUIT<br /></strong></p>
            <p>@asdromundo 2026. MIT License</p>
        </div>
    </body>
</rml>
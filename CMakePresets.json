{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop",
      "description": "Native desktop build (Linux / macOS / Windows).",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "desktop-debug",
      "displayName": "Desktop (Debug + ASan)",
      "description": "Debug build with AddressSanitizer. Requires the libasan runtime.",
      "binaryDir": "${sourceDir}/build/desktop-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASAN": "OFF"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "description": "wasm build. Requires the EMSDK environment variable pointing at the Emscripten SDK root.",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "3ds-release",
      "displayName": "Nintendo 3DS (Release)",
      "description": "Cross-compilation using devkitARM",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/3ds-release",
      "environment": {
        "DEVKITPRO": "/opt/devkitpro",
        "DEVKITARM": "/opt/devkitpro/devkitARM",
        "PATH": "/opt/devkitpro/tools/bin:/opt/devkitpro/devkitARM/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/3DS.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "web",
      "configurePreset": "web"
    },
    {
      "name": "3ds-release",
      "configurePreset": "3ds-release",
      "displayName": "Build 3DS"
    }
  ]
}
